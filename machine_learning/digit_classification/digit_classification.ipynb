0	"# Build the Sequential Neural Network model\n"
1	"model = keras.Sequential([\n"
2	"    keras.layers.Flatten(input_shape=(64,)),\n"
3	"    keras.layers.Dense(128, activation='relu'),\n"
4	"    keras.layers.Dense(10, activation='softmax')\n"
5	"])\n"
6	"\n"
7	"# Display model structural summary\n"
8	"model.summary()"
