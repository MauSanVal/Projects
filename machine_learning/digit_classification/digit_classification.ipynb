0	"# Define optimizer, loss function, and evaluation metrics\n"
1	"optimizer = keras.optimizers.SGD(learning_rate=0.01)\n"
2	"model.compile(\n"
3	"    optimizer=optimizer,\n"
4	"    loss='sparse_categorical_crossentropy',\n"
5	"    metrics=['accuracy']\n"
6	")"
